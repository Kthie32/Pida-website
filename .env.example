# Copy this file to ".env.local" (PowerShell:  Copy-Item .env.example .env.local ) and fill in YOUR values.
# ".env.local" is ignored by Git. Never commit real values.
#
# Both values are PUBLIC by design (they ship to every visitor's browser) and are safe only because
# the database enforces Row Level Security. Find them in Supabase: Project Settings > API.
#
# NEVER put the "service_role" key, the database password or any other secret in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLIC_PUBLISHABLE_KEY
